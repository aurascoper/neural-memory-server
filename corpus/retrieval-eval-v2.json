{
  "preRegisteredAt": "2026-07-31",
  "supersedes": "corpus/retrieval-eval.json (n=5 per class)",
  "preRegistrationNote": "Queries, relevance labels, metric and pass conditions fixed BEFORE any v2 arm was run. Void if edited after a run. Relevance judged as 'would a careful reader say this record answers the question', not 'which branch would find it'. The 20 v1 queries are carried through byte-for-byte and marked v1:true so the replication subset is separable.",
  "whyReplicationSubset": "The store grew from 75 records to 92 between v1 and v2, and embedding coverage went from 26 records to all of them. A change in the v2 result could therefore be the larger n, the larger corpus, or the fuller embedding coverage. Re-running the identical 20 v1 queries against the current store separates the first from the other two.",
  "knownBias": "The same author wrote the corpus, the branches and these queries. Paraphrases I choose may be ones the embedder happens to handle. This is a real limitation and no result here should be read as generalising beyond this corpus. It is mitigated only by fixing labels in advance and reporting per class rather than in aggregate.",
  "aliasClassCaveat": "Sharper than the general author bias and specific to C_alias: an alias query is a query the author wrote using an alias the author also wrote, declared in corpus/entities-m3.toml. The class measures whether the entity branch works as designed. It does not measure whether it helps on queries someone else would ask, and no result here should be read as if it did.",
  "labellingRules": [
    "Labels are record digests, not positions, so a supersede cannot silently move a label.",
    "Ten claim texts exist at two digests each; a label on one is expanded to both automatically.",
    "Retired records are never labelled relevant: default recall excludes them, so a retired target would be unreachable and would depress every arm equally."
  ],
  "whyPerClass": "An aggregate number would hide the answer. Semantic is supposed to win on paraphrase and lose nothing on verbatim; averaging those together produces a single figure that is true and uninformative.",
  "metric": "recall@5 and MRR@10, macro-averaged within each class",
  "arms": {
    "lexical": "FTS5 only. semantic off, entities off, maxHops 0",
    "lexical+semantic": "semantic on, entities off, maxHops 0",
    "lexical+entity": "semantic off, entities on, maxHops 0",
    "all": "everything on, maxHops 1"
  },
  "passConditions": {
    "semantic": "JUSTIFIED if it raises mean MRR on classes B and D by >= 0.05 absolute over lexical alone, AND lowers mean MRR on class A by no more than 0.05. Otherwise NOT JUSTIFIED on this corpus.",
    "entity": "JUSTIFIED if it raises mean MRR on class C by >= 0.05 over lexical alone, AND lowers no other class by more than 0.05."
  },
  "classes": {
    "A_verbatim": "wording lifted from the record; lexical should win",
    "B_paraphrase": "same meaning, different words; semantic should win if it works at all",
    "C_alias": "uses a declared entity alias; entity should win",
    "D_conceptual": "asks about a topic without naming specifics; hardest for all branches"
  },
