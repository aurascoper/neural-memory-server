# Build output. 1.2 GB against 440 KB of source.
/target/

# SQLite databases and their WAL/shared-memory sidecars. The store is one file
# by design, which makes it very easy to commit one by accident.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Editor and OS noise
*.swp
*~
.DS_Store

# Subagent transcripts and scratch (tool cache, not source)
/.pi-subagents/

# Agent session state and caches. 3.4 GB, and untracked-but-unignored is the
# dangerous combination: a single `git add -A` tries to publish all of it.
/.claude/

# Local experiment scratch. 65 MB of runs and intermediates, not source.
/experiments/
