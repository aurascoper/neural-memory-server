[Unit]
Description=Validate personal-memory sync key
RequiresMountsFor=/srv/neural-memory-data
ConditionPathIsMountPoint=/srv/neural-memory-data
After=local-fs.target

[Service]
Type=oneshot
User=neural-memory
Group=neural-memory
UMask=0077
Environment=NEURAL_MEMORY_PERSONAL_KEY=/srv/neural-memory-data/keys/gpd-ed25519.seed
ExecStart=/usr/local/bin/neural-memory-personal-sync public-key
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/neural-memory-data/keys
NoNewPrivileges=true
