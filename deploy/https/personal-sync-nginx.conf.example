server {
    listen 100.64.0.1:443 ssl;
    server_name gpd-personal-sync.tailnet.example;

    ssl_certificate /etc/neural-memory/tls/server.crt;
    ssl_certificate_key /srv/neural-memory-data/keys/server.key;
    ssl_client_certificate /etc/neural-memory/tls/enrolled-mac-ca.crt;
    ssl_verify_client on;

    location = /v1/personal-sync {
        limit_except POST { deny all; }
        client_max_body_size 8m;
        proxy_pass http://127.0.0.1:9443/v1/personal-sync;
        proxy_pass_request_headers off;
        proxy_set_header Content-Type application/json;
        proxy_set_header Content-Length $content_length;
        include /srv/neural-memory-data/keys/nginx-personal-sync-bearer.conf;
    }
    location / { return 404; }
}
